---
const { hasStreams } = Astro.props;

const inputClass = 'w-full px-4 py-2.5 rounded-xl border border-slate-700/50 bg-slate-900/80 text-white focus:outline-hidden focus:ring-2 focus:ring-sky-500/40 focus:border-sky-500/50 transition text-sm';
const labelClass = 'text-xs font-medium text-slate-400 mb-1 block';
---
<div id="createWrapper" class={hasStreams ? 'hidden' : ''}>
  <div class="bg-[#111a25] border border-[#1f2a37]/70 rounded-2xl p-4 sm:p-7 mb-6 sm:mb-10 shadow-xl shadow-black/30 animate-slideUp">
    <h3 class="text-base sm:text-lg font-medium mb-4 sm:mb-5 text-white/90">Add stream</h3>
    <form id="create" class="grid gap-5" autocomplete="off">
      <div class="grid md:grid-cols-2 gap-5">
        <div class="relative">
          <input
            class="peer w-full px-4 pt-5 pb-2 rounded-xl border border-slate-700/50 bg-slate-900/80 text-white focus:outline-hidden focus:ring-2 focus:ring-sky-500/40 focus:border-sky-500/50 transition text-sm placeholder-transparent"
            name="id"
            id="acestream-id"
            placeholder="AceStream ID"
            title="Paste an AceStream ID (40 hex chars), an acestream:// link or a getstream URL"
            required
          />
          <label for="acestream-id" class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm transition-all duration-200 pointer-events-none peer-focus:top-2.5 peer-focus:text-xs peer-focus:text-sky-400 peer-[:not(:placeholder-shown)]:top-2.5 peer-[:not(:placeholder-shown)]:text-xs">
            AceStream ID or link <span class="text-rose-400">*</span>
          </label>
          <span id="id-error" class="text-rose-400 text-xs hidden mt-1 block">Invalid: no 40-character infohash found</span>
          <div class="mt-1 flex items-center gap-3">
            <button
              type="button"
              id="detect-stream"
              class="text-xs text-sky-300 hover:text-sky-200 hover:underline disabled:opacity-50 disabled:no-underline transition-colors"
              title="Connect to the stream and read its channel name from the broadcast (DVB SDT)"
            >
              Detect from stream
            </button>
            <span id="resolve-status" class="text-xs hidden text-slate-500"></span>
          </div>
        </div>
        <div class="relative">
          <input
            class="peer w-full px-4 pt-5 pb-2 rounded-xl border border-slate-700/50 bg-slate-900/80 text-white focus:outline-hidden focus:ring-2 focus:ring-sky-500/40 focus:border-sky-500/50 transition text-sm placeholder-transparent"
            name="name"
            id="stream-name"
            placeholder="Name"
            required
          />
          <label for="stream-name" class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm transition-all duration-200 pointer-events-none peer-focus:top-2.5 peer-focus:text-xs peer-focus:text-sky-400 peer-[:not(:placeholder-shown)]:top-2.5 peer-[:not(:placeholder-shown)]:text-xs">
            Name <span class="text-rose-400">*</span>
          </label>
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-5">
        <div>
          <label for="photo-url" class={labelClass}>Logo / Photo URL <span class="text-slate-500">(optional)</span></label>
          <input class={inputClass} name="photo_url" id="photo-url" placeholder="https://…/logo.png" />
        </div>
        <div>
          <label for="group-title" class={labelClass}>Group <span class="text-slate-500">(optional)</span></label>
          <input class={inputClass} name="group_title" id="group-title" placeholder="e.g. Sports" />
        </div>
        <div>
          <label for="channel-number" class={labelClass}>Channel number <span class="text-slate-500">(optional)</span></label>
          <input class={inputClass} name="number" id="channel-number" type="number" min="1" max="99999" placeholder="1" />
        </div>
      </div>

      <label class="inline-flex items-center gap-2 text-sm text-slate-300 select-none">
        <input type="checkbox" name="enabled" id="enabled" checked class="accent-sky-500 w-4 h-4" />
        Enabled (published in the M3U / XMLTV)
      </label>

      <details class="rounded-xl border border-slate-700/50 bg-slate-900/40 px-4 py-3">
        <summary class="cursor-pointer text-sm text-slate-300">EPG / TV metadata <span class="text-slate-500">(auto-filled, optional)</span></summary>
        <p class="text-xs text-slate-500 mt-2 mb-3">
          These values link the channel to the guide and are auto-derived from the stream. Edit them only to match an external EPG.
        </p>
        <div class="grid md:grid-cols-2 gap-5">
          <div>
            <label for="tvg-id" class={labelClass}>TVG ID</label>
            <input class={inputClass} name="tvg_id" id="tvg-id" placeholder="epg.channel.id" />
          </div>
          <div>
            <label for="tvg-name" class={labelClass}>TVG Name</label>
            <input class={inputClass} name="tvg_name" id="tvg-name" placeholder="Channel name" />
          </div>
        </div>
      </details>

      <div class="flex items-center gap-4 pt-1">
        <button class="px-5 py-2.5 rounded-xl border border-sky-900/30 bg-sky-600 hover:bg-sky-500 text-white text-sm font-medium shadow-md transition-colors" type="submit">Add Stream</button>
        {hasStreams && <button type="button" id="cancelCreate" class="text-xs text-slate-400 hover:text-white transition-colors">Cancel</button>}
      </div>
      <p id="err" class="text-rose-300 text-sm font-medium pt-1" hidden></p>
    </form>
  </div>
</div>

<script>
  const idInput = document.getElementById('acestream-id') as HTMLInputElement;
  const idError = document.getElementById('id-error');
  const nameInput = document.getElementById('stream-name') as HTMLInputElement | null;
  const groupInput = document.getElementById('group-title') as HTMLInputElement | null;
  const tvgIdInput = document.getElementById('tvg-id') as HTMLInputElement | null;
  const tvgNameInput = document.getElementById('tvg-name') as HTMLInputElement | null;
  const resolveStatus = document.getElementById('resolve-status');
  const detectBtn = document.getElementById('detect-stream') as HTMLButtonElement | null;
  const createForm = document.getElementById('create') as HTMLFormElement | null;
  const formError = document.getElementById('err');

  let detectAbort: AbortController | null = null;
  let detectSeq = 0;
  const DETECT_LABEL = 'Detect from stream';

  // Values written by the automatic detection, per field. Anything else means
  // the user typed it: auto-fill may overwrite these, never user input.
  const autofill = {
    name: null as string | null,
    tvgName: null as string | null,
    tvgId: null as string | null,
    group: null as string | null,
  };

  function extractInfohash(raw: string): string | null {
    const value = raw.trim();
    const direct = value.match(/[0-9a-fA-F]{40}/);
    if (direct) return direct[0].toLowerCase();
    try {
      const url = new URL(value.replace(/^acestream:\/\//i, 'http://'));
      const id =
        url.searchParams.get('id') ??
        url.searchParams.get('infohash') ??
        url.searchParams.get('content_id');
      if (id && /^[0-9a-fA-F]{40}$/.test(id)) return id.toLowerCase();
    } catch {
      // not a URL
    }
    return null;
  }

  function setResolveStatus(text: string, tone: 'muted' | 'ok' | 'warn') {
    if (!resolveStatus) return;
    resolveStatus.textContent = text;
    resolveStatus.classList.remove('hidden');
    resolveStatus.className =
      'text-xs mt-1 block ' +
      (tone === 'ok' ? 'text-emerald-400' : tone === 'warn' ? 'text-amber-400' : 'text-slate-500');
  }

  // EPG id defaults to the AceStream infohash: stable and unique.
  function applyDefaultEpgId(id: string) {
    if (tvgIdInput && !tvgIdInput.value.trim()) tvgIdInput.value = id.toLowerCase();
  }

  function isReplaceable(input: HTMLInputElement | null, auto: string | null): boolean {
    if (!input) return false;
    const value = input.value.trim();
    return value === '' || (auto !== null && value === auto);
  }

  function applyName(name: string) {
    if (!name) return;
    if (isReplaceable(nameInput, autofill.name)) {
      if (nameInput) nameInput.value = name;
      autofill.name = name;
    }
    if (isReplaceable(tvgNameInput, autofill.tvgName)) {
      if (tvgNameInput) tvgNameInput.value = name;
      autofill.tvgName = name;
    }
  }

  // "DAZN F1 Spain" -> "dazn-f1-spain". Replaces an empty id, the infohash
  // default or a previous auto-suggestion; never overwrites user input.
  function applySuggestedEpgId(name: string) {
    if (!tvgIdInput) return;
    const current = tvgIdInput.value.trim();
    const isInfohash = /^[0-9a-f]{40}$/.test(current);
    const replaceable =
      current === '' || isInfohash || (autofill.tvgId !== null && current === autofill.tvgId);
    if (!replaceable) return;

    const slug = name
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 60);
    if (!slug) return;
    tvgIdInput.value = slug;
    autofill.tvgId = slug;
  }

  // Detection failed for the current id: drop values that came from a previous
  // auto-detection so the form never submits stale metadata.
  function clearAutoFilled(hash: string) {
    if (isReplaceable(nameInput, autofill.name)) {
      if (nameInput) nameInput.value = '';
    }
    if (isReplaceable(tvgNameInput, autofill.tvgName)) {
      if (tvgNameInput) tvgNameInput.value = '';
    }
    if (isReplaceable(tvgIdInput, autofill.tvgId) || /^[0-9a-f]{40}$/.test(tvgIdInput?.value.trim() ?? '')) {
      if (tvgIdInput) tvgIdInput.value = hash;
    }
    if (groupInput && autofill.group !== null && groupInput.value.trim() === autofill.group) {
      groupInput.value = '';
    }
    autofill.name = null;
    autofill.tvgName = null;
    autofill.tvgId = null;
    autofill.group = null;
  }

  function resetFormState() {
    detectAbort?.abort();
    detectAbort = null;
    autofill.name = null;
    autofill.tvgName = null;
    autofill.tvgId = null;
    autofill.group = null;

    if (resolveStatus) {
      resolveStatus.textContent = '';
      resolveStatus.classList.add('hidden');
    }
    if (formError) formError.hidden = true;
    if (idError) idError.classList.add('hidden');
    idInput?.classList.remove(
      'border-rose-500/50',
      'focus:ring-rose-500/40',
      'border-emerald-500/50',
      'focus:ring-emerald-500/40'
    );
    idInput?.classList.add('border-slate-700/50', 'focus:ring-sky-500/40');
  }

  // Covers both Cancel and the reset after a successful add.
  createForm?.addEventListener('reset', resetFormState);

  async function detectFromStream() {
    const hash = extractInfohash(idInput?.value ?? '');
    if (!hash) {
      setResolveStatus('Paste a valid AceStream ID first', 'warn');
      return;
    }

    applyDefaultEpgId(hash);
    detectAbort?.abort();
    detectAbort = new AbortController();
    const seq = ++detectSeq;

    if (detectBtn) {
      detectBtn.disabled = true;
      detectBtn.textContent = 'Detecting…';
    }
    setResolveStatus('Connecting to the stream to read its channel name…', 'muted');

    try {
      const res = await fetch(`/api/probe?id=${hash}`, { signal: detectAbort.signal });
      const data = (await res.json().catch(() => ({}))) as {
        serviceName?: string | null;
        serviceProvider?: string | null;
        title?: string | null;
        categories?: string[];
      };
      const name = data.serviceName || data.title || null;

      if (name) {
        applyName(name);
        applySuggestedEpgId(name);
        const categories = Array.isArray(data.categories) ? data.categories : [];
        if (groupInput && categories.length > 0) {
          const currentGroup = groupInput.value.trim();
          if (currentGroup === '' || (autofill.group !== null && currentGroup === autofill.group)) {
            groupInput.value = categories[0];
            autofill.group = categories[0];
          }
        }
        const provider = data.serviceProvider ? ` · ${data.serviceProvider}` : '';
        setResolveStatus(`Detected: ${name}${provider}`, 'ok');
      } else {
        clearAutoFilled(hash);
        setResolveStatus('Could not read a channel name from the stream', 'warn');
      }
    } catch (err) {
      if ((err as { name?: string })?.name === 'AbortError') return;
      clearAutoFilled(hash);
      setResolveStatus('Detection failed', 'warn');
    } finally {
      if (detectBtn && seq === detectSeq) {
        detectBtn.disabled = false;
        detectBtn.textContent = DETECT_LABEL;
      }
    }
  }

  detectBtn?.addEventListener('click', detectFromStream);

  // Re-detect when any auto-fillable field is still empty or holds a value
  // written by a previous detection (or the infohash default). Fields the user
  // typed are left alone and never trigger a rewrite.
  function needsDetection(): boolean {
    const tvgId = tvgIdInput?.value.trim() ?? '';
    return (
      isReplaceable(nameInput, autofill.name) ||
      isReplaceable(tvgNameInput, autofill.tvgName) ||
      isReplaceable(tvgIdInput, autofill.tvgId) ||
      /^[0-9a-f]{40}$/.test(tvgId)
    );
  }

  function autoDetectFromStream() {
    if (!needsDetection()) return;
    void detectFromStream();
  }

  if (idInput && idError) {
    idInput.addEventListener('input', () => {
      const value = idInput.value.trim();
      const hash = extractInfohash(value);

      if (value === '') {
        idError.classList.add('hidden');
        idInput.classList.remove('border-rose-500/50', 'focus:ring-rose-500/40');
        idInput.classList.add('border-slate-700/50', 'focus:ring-sky-500/40');
      } else if (!hash) {
        idError.classList.remove('hidden');
        idInput.classList.remove('border-slate-700/50', 'focus:ring-sky-500/40');
        idInput.classList.add('border-rose-500/50', 'focus:ring-rose-500/40');
      } else {
        idError.classList.add('hidden');
        idInput.classList.remove('border-rose-500/50', 'focus:ring-rose-500/40');
        idInput.classList.add('border-slate-700/50', 'border-emerald-500/50', 'focus:ring-emerald-500/40');
        applyDefaultEpgId(hash);
      }
    });

    idInput.addEventListener('blur', () => {
      const value = idInput.value.trim();
      if (value === '') return;
      const hash = extractInfohash(value);
      if (!hash) {
        idError.classList.remove('hidden');
      } else {
        idInput.value = hash;
      }
    });

    idInput.addEventListener('change', () => {
      autoDetectFromStream();
    });
  }
</script>
