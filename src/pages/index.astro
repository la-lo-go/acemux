---
import { getAllStreams, type Stream } from '../lib/db'
import StreamForm from '../lib/components/StreamForm.astro'
import StreamCard from '../lib/components/StreamCard.astro'
import '../styles.css'

// Server-side data fetching for SSR
let streams: Stream[] = []
let error = ''

try {
  streams = getAllStreams()
} catch (err) {
  console.error('Failed to load streams:', err)
  error = err instanceof Error ? err.message : 'Unknown error loading streams'
  streams = []
}
const hasStreams = streams.length > 0
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>AceMux - Stream Manager</title>
    <meta name="description" content="AceMux - A simple and elegant stream manager" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎬</text></svg>" />
    <meta name="theme-color" content="#0a0d12" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="AceMux" />
    <link rel="apple-touch-icon" href="/icon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script define:vars={{ aceStreamBase: import.meta.env.ACESTREAM_BASE || 'http://acestream:6878' }}>
      window.aceStreamBase = aceStreamBase.replace(/\/+$/, '');
    </script>
  </head>
  <body class="m-0 bg-[#0a0d12] min-h-screen text-[#e6eef7] font-[system-ui,Segoe UI,Roboto,Arial,sans-serif] leading-[1.4] animate-fadeIn">
    <div class="relative mx-auto w-full px-4 sm:px-6 py-6 sm:py-8 max-w-[1000px] xl:max-w-[1040px] 2xl:max-w-[1080px] transition-[max-width] duration-300">
      <div class="flex items-center justify-between gap-3 sm:gap-4 mb-6 sm:mb-8 flex-wrap">
        <h1 class="m-0 text-2xl sm:text-[32px] font-bold tracking-tight text-sky-300 drop-shadow-sm">AceMux</h1>
        <div class="flex items-center gap-2">
          <!-- Split button: + Add Stream | ▾ (dropdown with Import) -->
          <div class="flex relative">
            <button id="showCreate" class="px-5 py-2.5 rounded-l-xl border border-r-0 border-slate-700/50 bg-[#12202e] hover:bg-[#162a3d] transition-colors text-sm font-medium shadow-md">
              + Add Stream
            </button>
            <button id="addMenuToggle" class="px-2.5 py-2.5 rounded-r-xl border border-slate-700/50 bg-[#12202e] hover:bg-[#162a3d] transition-colors shadow-md" title="More options">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/></svg>
            </button>
            <div id="addMenu" class="hidden absolute right-0 top-full mt-1 z-50 bg-[#111a24] border border-slate-700/50 rounded-xl shadow-xl overflow-hidden min-w-[160px]">
              <button id="importBtn" class="w-full text-left px-4 py-2.5 hover:bg-[#162a3d] transition-colors text-sm whitespace-nowrap">
                Import from JSON
              </button>
            </div>
          </div>
          <input id="importFile" type="file" accept=".json" class="hidden" />
        </div>
      </div>

      <StreamForm hasStreams={hasStreams} />

      {hasStreams && (
        <div class="flex gap-3 flex-wrap items-center mb-5">
          <input id="searchInput" type="search" placeholder="Search streams…"
            class="flex-1 min-w-[160px] px-4 py-2 rounded-xl border border-slate-700/50 bg-[#12202e] text-sm outline-none focus:border-slate-500" />
          <select id="sortSelect"
            class="px-3 py-2 rounded-xl border border-slate-700/50 bg-[#12202e] text-sm">
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
            <option value="name-asc">Name A → Z</option>
            <option value="name-desc">Name Z → A</option>
            <option value="favorites">Favorites first</option>
          </select>
          <button id="viewToggle" title="Switch to list view"
            class="px-3 py-2 rounded-xl border border-slate-700/50 bg-[#12202e] hover:bg-[#162a3d] transition-colors text-sm flex items-center">
            <span data-grid-icon>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/>
                <rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/>
              </svg>
            </span>
            <span data-list-icon class="hidden">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
              </svg>
            </span>
          </button>
          <button id="exportBtn" title="Export streams to JSON"
            class="px-3 py-2 rounded-xl border border-slate-700/50 bg-[#12202e] hover:bg-[#162a3d] transition-colors text-sm">Export</button>
          <button id="bulkBtn"
            class="px-3 py-2 rounded-xl border border-slate-700/50 bg-[#12202e] hover:bg-[#162a3d] transition-colors text-sm">Select</button>
        </div>
      )}

      <div id="list" class="grid gap-5 animate-slideUp md:grid-cols-2 items-start">
        {!hasStreams && <p class="opacity-80 text-xs italic text-center py-6 md:col-span-2">No streams yet. Add the first one above.</p>}
        <p id="noResults" class="hidden opacity-80 text-xs italic text-center py-6 md:col-span-2">No streams match your search.</p>
        {streams.map((s: Stream) => (
          <StreamCard stream={s} />
        ))}
      </div>
    </div>

    <!-- Bulk action bar (fixed bottom, shown in select mode) -->
    <div id="bulkBar" class="hidden fixed bottom-0 left-0 right-0 z-50 bg-[#111a24] border-t border-slate-700/50 px-4 py-3 flex items-center justify-between gap-4 shadow-xl">
      <span id="bulkCount" class="text-sm text-slate-300">0 selected</span>
      <div class="flex gap-2">
        <button id="bulkDelete" class="px-4 py-2 rounded-xl border border-[#7f1d1d]/60 bg-[#2a1618] hover:bg-[#351a1c] transition-colors text-rose-200/90 hover:text-rose-200 text-sm font-medium">Delete selected</button>
        <button id="bulkCancel" class="px-4 py-2 rounded-xl border border-slate-700/50 bg-[#12202e] hover:bg-[#162a3d] transition-colors text-sm font-medium">Cancel</button>
      </div>
    </div>

    <script>
      import { initHomePage } from '../lib/home';
      document.addEventListener('DOMContentLoaded', initHomePage);
    </script>
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js');
      }
    </script>
  </body>
</html>
