# ============================================================================
# AceMux - Ejemplo de variables de entorno
# Copia este fichero a `.env` y ajusta los valores a tu instalación.
# ============================================================================

# URL del engine AceStream.
# - Si usas Docker Compose con el servicio `acestream`, deja el nombre del servicio.
# - Si el engine corre en otra máquina, usa su IP y puerto (p. ej. http://192.168.1.100:6878).
ACESTREAM_ENGINE_URL=http://acestream:6878

# URL base de acemux que deben usar los clientes (Plex, Jellyfin, VLC).
# IMPORTANTE: debe ser una dirección alcanzable desde esos clientes, normalmente
# la IP LAN del host donde corre acemux (NO `localhost`, que cada cliente resolvería
# a sí mismo). En Docker Desktop (Windows/macOS) pon la IP LAN del host.
# Si se deja vacía, acemux la deriva del Host de cada petición.
PUBLIC_BASE_URL=http://192.168.1.100:4321

# Token que protege /playlist.m3u, /stream/:id y /xmltv.xml.
# Si se deja vacío, esos endpoints quedan abiertos a cualquiera. Rellénalo en
# instalaciones accesibles desde la red.
# Los endpoints del tuner para Plex (/discover.json, /lineup.json,
# /lineup_status.json, /device.xml y /hdhr/xmltv.xml) no pueden pedir token
# (Plex no lo envía): mantenlos solo en una LAN de confianza.
ACEMUX_API_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio

# Días de EPG de relleno que se generan para la guía XMLTV (por defecto 2).
EPG_FILLER_DAYS=2

# Identidad HDHomeRun que AceMux presenta a Plex (8 hex). Normalmente no hace
# falta: AceMux genera una por instalación y la guarda en la base de datos.
# HDHR_DEVICE_ID=

# Zona horaria usada para la programación de la EPG.
TZ=UTC

# Puerto en el que escucha acemux.
PORT=4321

# Interfaz de red a la que se enlaza acemux. 0.0.0.0 escucha en todas.
HOST=0.0.0.0

# Ruta del fichero SQLite donde se guardan los streams.
DATABASE_PATH=./data/db.sqlite

# ============================================================================
# Concurrencia (varios espectadores / varios canales)
# ============================================================================
# El engine AceStream solo sirve un reproductor por stream. AceMux mantiene una
# unica sesion upstream por canal y la reparte entre todos los clientes. Estos
# limites controlan cuanta gente/canales se permiten a la vez.

# Maximo de espectadores compartiendo un mismo canal (0 = sin limite).
MAX_CLIENTS_PER_STREAM=6

# Maximo de canales distintos descargandose a la vez (0 = sin limite).
MAX_CONCURRENT_STREAMS=3

# Tiempo (ms) que se mantiene viva una sesion sin clientes antes de pararla
# (permite reconexiones sin reiniciar la descarga P2P).
STREAM_STOP_GRACE_MS=10000

# Player id que AceMux envia al engine. Evita que otro reproductor lo sustituya.
ACESTREAM_PLAYER_ID=acemux
