{
  "name": "acemux",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "bun --bun astro build && bun run ./dist/server/entry.mjs",
    "dev:watch": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview",
    "start": "bun run ./dist/server/entry.mjs",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "astro": "^7.3.2",
    "astro-icon": "^1.2.0",
    "mpegts.js": "^1.8.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  }
}
